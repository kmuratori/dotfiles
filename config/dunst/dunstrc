[global]
    # Display
    monitor = 0
    follow = mouse
    width = 340
    height = 300
    origin = bottom-right # top-right
    offset = 0x34 #0x28
    scale = 0
    notification_limit = 3

    # Layout
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 320
    progress_bar_corner_radius = 0
    icon_corner_radius = 0

    indicate_hidden = yes
    transparency = 12
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 2
    frame_color = "#454545"          # border
    gap_size = 6
    separator_color = frame
    sort = yes

    # Text
    font = Bitstream Vera Sans Mono 14
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Icons
    icon_theme = "Papirus-Dark, hicolor"
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 0
    max_icon_size = 40

    # History
    sticky_history = yes
    history_length = 20

    # Misc
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false
    force_xinerama = false

    # Mouse
    mouse_left_click   = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click  = close_all

    corner_radius = 0

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background  = "#1f1f1fe8"         # bg
    foreground  = "#888888"           # muted
    frame_color = "#454545"           # border
    timeout = 5
    default_icon = dialog-information

[urgency_normal]
    background  = "#373737e8"         # surface
    foreground  = "#ffffff"           # fg
    frame_color = "#777777"           # focus
    timeout = 8
    default_icon = dialog-information

[urgency_critical]
    background  = "#664317f0"         # warn_bg
    foreground  = "#ffffff"           # fg
    frame_color = "#C94F4F"           # critical (red)
    timeout = 0
    default_icon = dialog-warning

# MPD track change notification
[mpd]
    appname = mpd
    frame_color = "#2FBF71"           # good (playing)
    timeout = 4
