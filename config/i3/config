# set modified key to the Windows button
set $mod Mod4

exec --no-startup-id   dex --autostart --environment i3
exec --no-startup-id   xrdb -merge ~/.config/X11/Xresources
exec --no-startup-id   dunst
exec --no-startup-id   ~/.fehbg
exec --no-startup-id   picom --config ~/.config/picom/picom.conf
exec --no-startup-id   cmst -m
exec --no-startup-id   udiskie --tray
exec --no-startup-id   pgrep -x pipewire >/dev/null || pipewire &
# exec --no-startup-id pgrep -x pipewire-pulse >/dev/null || pipewire-pulse &
# exec --no-startup-id pgrep -x wireplumber >/dev/null || wireplumber &
exec --no-startup-id   mpd
exec --no-startup-id   sxhkd
# exec --no-startup-id syncthing
exec --no-startup-id   ~/.local/bin/lifeops serve > ~/.cache/lifeops.log
exec --no-startup-id   ~/.local/bin/battery-watch

# remove window titles from no stacked/tabbed windows.
for_window [class="^.*"] border pixel 2

# remove gaps between tiled windows. I hate gaps.
gaps inner 0
gaps outer 0

# use the default monospace font, set in ~/.config/fontconfig/fonts.conf
font pango:monospace 13

# bind main to windows+shift+s
bindsym $mod+Shift+s exec --no-startup-id flameshot gui

# rofi as an application launcher
bindsym $mod+p exec "rofi -show drun"

set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && pkill -RTMIN+1 i3status-rs
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && pkill -RTMIN+1 i3status-rs
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && pkill -RTMIN+1 i3status-rs
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

floating_modifier $mod
tiling_drag modifier

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show
bindsym $mod+Shift+c kill
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent
#bindsym $mod+d focus child

bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86MonBrightnessUp   exec brightnessctl set 5%+
bindsym XF86Explorer          exec pcmanfm
bindsym Print                 exec flameshot gui

# apps
bindsym $mod+Shift+Return exec i3-sensible-terminal
bindsym $mod+Shift+w      exec nsxiv -bft $WALLPAPERS_PATH
bindsym $mod+Shift+p      exec rofi -show window
bindsym $mod+Shift+b      bar mode toggle
bindsym $mod+Escape       exec ~/.local/bin/scripts/key_logout.sh
# bindsym $mod+w            exec qutebrowser
bindsym $mod+b            exec boomer
bindsym $mod+m            exec ~/.local/bin/scripts/menu.sh
bindsym $mod+n            exec ~/.local/bin/scripts/open_notes
# bindsym $mod+Shift+t      exec ~/.config/i3/scripts/theme-switcher.sh
bindsym $mod+g            exec chromium

# Window rules
for_window [class="Alacritty" title="calender"] floating enable
for_window [class="Alacritty" title="calender"] move position mouse
for_window [class="Alacritty" title="calender"] border pixel 2
for_window [class="ncmpcpp-float"]              floating enable
for_window [class="ncmpcpp-float"]              resize set 900 500
for_window [class="ncmpcpp-float"]              move position center
for_window [class="ncmpcpp-float"]              border pixel 2
for_window [class="cava-float"]                 floating enable
for_window [class="cava-float"]                 resize set 700 200
for_window [class="cava-float"]                 move position center
for_window [class="cava-float"]                 border pixel 1
for_window [window_role="pop-up"]               floating enable
for_window [title="webcam"]                     floating enable
for_window [class="Pavucontrol"]                floating enable
for_window [class="sowon"]                      floating enable

# Workspaces

# set $ws1 "1"
# set $ws2 "2"
# set $ws3 "3"
# set $ws4 "4"
# set $ws5 "5"
# set $ws6 "6"
# set $ws7 "7"
# set $ws8 "8"
# set $ws9 "9"
# set $ws10 "10"

set $ws1  "1:一"
set $ws2  "2:二"
set $ws3  "3:三"
set $ws4  "4:四"
set $ws5  "5:五"
set $ws6  "6:六"
set $ws7  "7:七"
set $ws8  "8:八"
set $ws9  "9:九"
set $ws10 "10:十"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+r reload
# bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

mode "resize" {
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

set $focused    #777777
set $unfocused  #373737
set $black      #000000
set $white      #ffffff
set $background #1f1f1f
set $base       #454545
set $grey       #373737
set $warning    #664317

# target                 border      background  text     indicator   child_border
client.focused           $focused    $focused    $white   $focused    $focused
client.focused_inactive  $focused    $unfocused  $white   $unfocused  $unfocused
client.unfocused         $focused    $unfocused   $white   $unfocused  $unfocused
client.urgent            $warning    $warning      $white   $warning    $warning
# client.placeholder     <border>    <background>  <text> <indicator>
client.background        $background

bar {
    status_command i3status-rs ~/.config/i3status-rust/config.toml
    position bottom
    font pango:monospace 13
    tray_output primary
    colors {
        background #1f1f1f
        statusline #ffffff
        separator  #454545
        focused_workspace  #777777 #777777 #ffffff
        active_workspace   #373737 #373737 #ffffff
        inactive_workspace #1f1f1f #1f1f1f #888888
        urgent_workspace   #664317 #664317 #ffffff
    }
}

