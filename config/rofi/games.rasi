/* games.rasi — game library grid
 * rofi -show games -theme ~/.config/rofi/games.rasi
 */

configuration {
    modi:       "games:~/.local/bin/list-games.sh";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font:       "Bitstream Vera Sans Mono 11";
}

* {
    bg:       #1f1f1f;
    surface:  #373737;
    border:   #454545;
    focus:    #777777;
    muted:    #888888;
    fg:       #ffffff;
    black:    #000000;
    warn-bg:  #664317;
    good:     #2FBF71;
    warn:     #D0A050;
    critical: #C94F4F;

    background-color: transparent;
    text-color:       @fg;
    border-color:     @border;
    spacing:          0;
}

window {
    width:            760px;
    background-color: @bg;
    border:           1px solid;
    border-color:     @border;
}

mainbox {
    padding:  14px;
    spacing:  12px;
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: @surface;
    border:           1px solid;
    border-color:     @border;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @muted;
}

entry {
    placeholder:       "Search games…";
    placeholder-color: @muted;
    cursor:            text;
}

listview {
    columns:      4;
    lines:        2;
    fixed-height: true;
    fixed-columns: true;
    scrollbar:    false;
    cycle:        true;
    spacing:      10px;
}

element {
    orientation:   vertical;
    padding:       16px 8px 12px 8px;
    spacing:       10px;
    border:        1px solid;
    border-color:  transparent;
    text-color:    @muted;
    children:      [ element-icon, element-text ];
}

element selected {
    background-color: @surface;
    border-color:     @focus;
    text-color:       @fg;
}

element-icon {
    size:             72px;
    horizontal-align: 0.5;
}

element-text {
    text-color:       inherit;
    horizontal-align: 0.5;
    highlight:        bold underline #ffffff;
}

message {
    background-color: @surface;
    border:           1px solid;
    border-color:     @border;
    padding:          8px 12px;
}

textbox {
    text-color: @muted;
}
