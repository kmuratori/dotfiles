#!/usr/bin/env bash
# cpf - copy text file contents (with optional headers) to the clipboard.
#       File names may also come from stdin:  find ... | cpf

tmp=$(mktemp) || exit 1
bufs=()
cleanup() { rm -f "$tmp" "${bufs[@]}"; }
trap cleanup EXIT

# True for readable files that look like text.
# "Text" = contains no NUL bytes (grep -I decides this by scanning
# for a NUL and bailing out if it finds one). Empty files count as text.
is_text() {
  [ -r "$1" ] || return 1
  [ -s "$1" ] || return 0
  LC_ALL=C grep -Iq . -- "$1" 2>/dev/null
}

mode=wrap
sep=$'\n'                       # stdin record separator (newline by default)
while [ $# -gt 0 ]
do
  case "$1"
  in
    -noh) mode=noh; shift ;;
    -sh)  mode=sh;  shift ;;
    -0)   sep='';   shift ;;    # NUL-separated stdin (find -print0)
    --)   shift; break ;;
    *)    break ;;
  esac
done

files=("$@")

# No file arguments: read the list from stdin, e.g. `find ... | cpf`.
if [ ${#files[@]} -eq 0 ]
then
  if [ -t 0 ]
  then
    printf 'usage: cpf [-0] [-noh|-sh] [FILE...]\n' >&2
    printf '       find ... -print  | cpf\n'       >&2
    printf '       find ... -print0 | cpf -0\n'    >&2
    exit 1
  fi
  while IFS= read -r -d "$sep" f || [ -n "$f" ]
  do
    [ -n "$f" ] && files+=("$f")
  done
fi

if [ ${#files[@]} -eq 0 ]
then
  printf 'cpf: no files\n' >&2
  exit 1
fi

for f in "${files[@]}"
do
  if [ ! -e "$f" ]
  then
    case "$f"
    in
      *[\*\?\[]*) printf 'cpf: no match: %s\n'  "$f" >&2 ;;
      *)          printf 'cpf: not found: %s\n' "$f" >&2 ;;
    esac
    continue
  fi

  [ -d "$f" ] && continue

  src="$f"

  # Regular files: use directly. Pipes / process substitution <(cmd) /
  # FIFOs are one-shot, so buffer them once — otherwise the text check
  # and the output would compete for the same bytes.
  if [ ! -f "$f" ]
  then
    if [ ! -p "$f" ]
    then
      printf 'cpf: skipping non-text: %s\n' "$f" >&2
      continue
    fi
    if [ ! -r "$f" ]
    then
      printf 'cpf: not readable: %s\n' "$f" >&2
      continue
    fi
    b=$(mktemp) || { printf 'cpf: mktemp failed\n' >&2; continue; }
    bufs+=("$b")
    if ! cat -- "$f" > "$b"
    then
      printf 'cpf: read failed: %s\n' "$f" >&2
      continue
    fi
    src="$b"
  fi

  if ! is_text "$src"
  then
    printf 'cpf: skipping non-text: %s\n' "$f" >&2
    continue
  fi

  case "$mode" in
    noh)
      cat -- "$src"; echo ;;
    sh)
      printf 'cat > %q << '\''EOF'\''\n' "$f"
      cat -- "$src"
      printf 'EOF\n' ;;
    wrap)
      printf '%s:\n' "$f"
      cat -- "$src"
      printf '==========\n\n' ;;
  esac
done > "$tmp"

if [ -n "${WAYLAND_DISPLAY-}" ] && command -v wl-copy >/dev/null 2>&1
then
  wl-copy < "$tmp"
else
  xclip -selection clipboard < "$tmp"
fi
